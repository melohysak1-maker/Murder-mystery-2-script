-- UTILITÁRIOS: DETECÇÃO DE PAPÉIS (ROLES)
---------------------------------------------------------
local function GetPlayerRole(plr)
    if not plr or not plr.Character then return "Innocent" end
    
    local knife = plr.Backpack:FindFirstChild("Knife") or plr.Character:FindFirstChild("Knife")
    local gun = plr.Backpack:FindFirstChild("Gun") or plr.Character:FindFirstChild("Gun") or plr.Backpack:FindFirstChild("Revolver") or plr.Character:FindFirstChild("Revolver")
    
    if knife then
        return "Murderer"
    elseif gun then
        return "Sheriff"
    else
        return "Innocent"
    end
end

---------------------------------------------------------
-- SISTEMA ESP INTEGRADO & COMPLETO
---------------------------------------------------------
local ESPContainer = Instance.new("Folder", Workspace)
ESPContainer.Name = "MM2_Advanced_ESP"

local function CleanESP()
    ESPContainer:ClearAllChildren()
end

local function UpdateESP()
    CleanESP()
    if not Settings.PlayerESP then return end
    
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
            local role = GetPlayerRole(plr)
            local draw = false
            local color = Color3.fromRGB(0, 255, 0)
            
            if role == "Murderer" and Settings.MurdererESP then
                color = Color3.fromRGB(255, 0, 0)
                draw = true
            elseif role == "Sheriff" and Settings.SheriffESP then
                color = Color3.fromRGB(0, 150, 255)
                draw = true
            elseif role == "Innocent" and Settings.InnocentESP then
                draw = true
            end
            
            if draw then
                local hl = Instance.new("Highlight")
                hl.Name = plr.Name .. "_ESP"
                hl.Adornee = plr.Character
                hl.FillColor = color
                hl.FillTransparency = 0.4
                hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                hl.Parent = ESPContainer
            end
        end
    end
    
    if Settings.GunESP then
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj.Name == "GunDrop" or (obj:IsA("Tool") and (obj.Name == "Gun" or obj.Name == "Revolver") and obj.Parent == Workspace) then
                local hl = Instance.new("Highlight")
                hl.Adornee = obj
                hl.FillColor = Color3.fromRGB(255, 255, 0)
                hl.Parent = ESPContainer
            end
        end
    end

    if Settings.CoinESP then
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj.Name == "CoinContainer" or obj.Name == "Coin" then
                local hl = Instance.new("Highlight")
                hl.Adornee = obj
                hl.FillColor = Color3.fromRGB(255, 215, 0)
                hl.Parent = ESPContainer
            end
        end
    end
end

task.spawn(function()
    while task.wait(1) do
        UpdateESP()
    end
end)

