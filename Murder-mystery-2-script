-- 🎯 SISTEMA DE AIM LOCK (MIRA TRAVADA)
---------------------------------------------------------
local Camera = Workspace.CurrentCamera
local Mouse = LocalPlayer:GetMouse()

local function GetAimTarget()
    local bestTarget = nil
    local bestScore = math.huge
    local myPos = Camera.CFrame.Position
    local mousePos = UserInputService:GetMouseLocation()

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LocalPlayer then continue end
        if not plr.Character then continue end
        
        local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
        local hum = plr.Character:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum or hum.Health <= 0 then continue end

        local role = GetPlayerRole(plr)

        local valid = false
        if Settings.AimTargetMode == "Murderer" then
            valid = (role == "Murderer")
        elseif Settings.AimTargetMode == "Sheriff" then
            valid = (role == "Sheriff")
        elseif Settings.AimTargetMode == "Both" then
            valid = (role == "Murderer" or role == "Sheriff")
        elseif Settings.AimTargetMode == "Closest" then
            valid = true
        end
        if not valid then continue end

        local part = plr.Character:FindFirstChild(Settings.AimPart)
            or plr.Character:FindFirstChild("Head")
            or hrp

        local screenPos, onScreen = Camera:WorldToViewportPoint(part.Position)
        if not onScreen then continue end
        
        local dist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
        if dist > Settings.AimFOV then continue end

        if Settings.AimVisibleCheck then
            local params = RaycastParams.new()
            params.FilterType = Enum.RaycastFilterType.Exclude
            params.FilterDescendantsInstances = {LocalPlayer.Character, plr.Character}
            local result = Workspace:Raycast(myPos, part.Position - myPos, params)
            if result then continue end
        end

        if dist < bestScore then
            bestScore = dist
            bestTarget = part
        end
    end

    return bestTarget
end

RunService.RenderStepped:Connect(function(dt)
    if not Settings.AimLockEnabled then return end
    if Settings.AimUseKeybind and not Settings.AimKeybindHeld then return end
    if not Character or not Character:FindFirstChild("HumanoidRootPart") then return end

    local target = GetAimTarget()
    if not target then return end

    local camPos = Camera.CFrame.Position
    local lookAt = CFrame.new(camPos, target.Position)
    Camera.CFrame = Camera.CFrame:Lerp(lookAt, math.clamp(Settings.AimSmoothness, 0.01, 1))
end)

UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if input.KeyCode == Settings.AimKeybind then
        Settings.AimKeybindHeld = true
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.KeyCode == Settings.AimKeybind then
        Settings.AimKeybindHeld = false
    end
end)

